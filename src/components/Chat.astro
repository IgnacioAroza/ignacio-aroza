---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const c = t[lang].chat;
---

<div class="chat" id="chat" data-left={c.left} data-wait={c.wait} data-limit={c.limit} data-err={c.err}>
  <div class="bubble" id="bubble" role="status" aria-live="polite" hidden></div>
  <form id="chatform" autocomplete="off">
    <input id="q" type="text" maxlength="300" required placeholder={c.ph} aria-label={c.label} />
    <button type="submit" aria-label={c.send}>↑</button>
  </form>
  <div class="limit" id="limit"></div>
</div>

<script is:inline>
  (() => {
    const box = document.getElementById('chat'), d = box.dataset;
    const bubble = document.getElementById('bubble'), limit = document.getElementById('limit');
    const form = document.getElementById('chatform'), q = document.getElementById('q');
    // ponytail: el contador real vive en Upstash; localStorage solo recuerda el último valor para mostrarlo al recargar.
    const today = new Date().toDateString();
    let left = 10;
    try { const v = JSON.parse(localStorage.getItem('chatLeft')); if (v?.day === today) left = v.left; } catch {}
    const show = () => { limit.textContent = d.left.replace('{n}', left); };
    const save = () => { try { localStorage.setItem('chatLeft', JSON.stringify({ day: today, left })); } catch {} };
    show();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = q.value.trim();
      if (!text || form.inert) return;
      form.inert = true;
      bubble.hidden = false;
      bubble.textContent = d.wait;
      try {
        const r = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ q: text }) });
        const res = await r.json();
        if (typeof res.left === 'number') { left = res.left; save(); show(); }
        bubble.textContent = res.answer ?? (r.status === 429 ? d.limit : d.err);
        if (res.answer) q.value = '';
      } catch {
        bubble.textContent = d.err;
      }
      form.inert = false;
      q.focus();
    });
  })();
</script>

<style>
  .chat { position: fixed; left: 0; right: 0; bottom: 0; padding: 12px max(16px, env(safe-area-inset-right, 0px)) calc(14px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); display: flex; flex-direction: column; align-items: center; gap: 8px; pointer-events: none; z-index: 20; background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 92%, transparent) 55%); }
  .chat > * { pointer-events: auto; }
  .bubble { max-width: 560px; width: 100%; max-height: 40vh; overflow-y: auto; background: var(--surface-2); border: 1px solid var(--line); border-radius: 14px; padding: 12px 16px; font-size: 14px; white-space: pre-line; }
  form { display: flex; gap: 8px; width: 100%; max-width: 560px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 6px 6px 18px; box-shadow: 0 10px 40px -10px #000; }
  form:focus-within { border-color: var(--accent); }
  form[inert] { opacity: .6; }
  input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 400 15px var(--f-body); outline: none; }
  input::placeholder { color: var(--muted); }
  button { width: 38px; height: 38px; border-radius: 50%; border: 0; background: var(--accent); color: var(--accent-ink); font-weight: 800; }
  .limit { font: 400 11px var(--f-mono); color: var(--muted); }
</style>
