---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const c = t[lang].chat;
---

<div class="chat" id="chat" data-left={c.left} data-wait={c.wait} data-limit={c.limit} data-err={c.err} data-open={c.open} data-close={c.close}>
  <section class="panel" id="panel" aria-label={c.title} hidden>
    <h2>{c.title}</h2>
    <div class="bubble" id="bubble" role="status" aria-live="polite">{c.greet}</div>
    <form id="chatform" autocomplete="off">
      <input id="q" type="text" maxlength="300" required placeholder={c.ph} aria-label={c.label} />
      <button type="submit" aria-label={c.send}>↑</button>
    </form>
    <div class="limit" id="limit"></div>
  </section>
  <p class="nudge" id="nudge" hidden>{c.nudge}</p>
  <button class="fab" id="fab" type="button" aria-expanded="false" aria-controls="panel" aria-label={c.open}>
    <svg class="i-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8l5 4-5 4" /><path class="us" d="M13 17h6" /></svg>
    <svg class="i-x" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</div>

<script is:inline>
  (() => {
    const box = document.getElementById('chat'), d = box.dataset;
    const bubble = document.getElementById('bubble'), limit = document.getElementById('limit');
    const form = document.getElementById('chatform'), q = document.getElementById('q');
    const fab = document.getElementById('fab'), panel = document.getElementById('panel'), nudge = document.getElementById('nudge');

    const toggle = (open) => {
      panel.hidden = !open;
      nudge.hidden = true;
      fab.setAttribute('aria-expanded', open);
      fab.setAttribute('aria-label', open ? d.close : d.open);
      if (open) q.focus(); else fab.focus();
    };
    // La burbuja llama la atención (pulso + guion que parpadea) desde que aparece el globito y hasta que alguien la abre; el primer click lo apaga por toda la sesión.
    let seen = false;
    try { seen = !!sessionStorage.getItem('chatSeen'); } catch {}
    fab.addEventListener('click', () => {
      seen = true;
      fab.classList.remove('call');
      try { sessionStorage.setItem('chatSeen', '1'); } catch {}
      toggle(panel.hidden);
    });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) toggle(false); });

    // Globito de invitación: una sola vez por sesión, a los 7s o 3s después de tocar la lámpara (lo que ocurra primero).
    let timer, shown = false;
    try { shown = !!sessionStorage.getItem('chatNudge'); } catch {}
    if (shown && !seen) fab.classList.add('call');
    const invite = (ms) => {
      if (shown || seen) return;
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (!panel.hidden || seen) return;
        shown = true;
        fab.classList.add('call');
        try { sessionStorage.setItem('chatNudge', '1'); } catch {}
        nudge.hidden = false;
        setTimeout(() => (nudge.hidden = true), 8000);
      }, ms);
    };
    invite(7000);
    document.addEventListener('click', (e) => { if (e.target.closest('#lamp')) invite(3000); });
    // ponytail: el contador real vive en Upstash; localStorage solo recuerda el último valor para mostrarlo al recargar.
    const today = new Date().toDateString();
    let left = 10;
    try { const v = JSON.parse(localStorage.getItem('chatLeft')); if (v?.day === today) left = v.left; } catch {}
    const show = () => { limit.textContent = d.left.replace('{n}', left); };
    const save = () => { try { localStorage.setItem('chatLeft', JSON.stringify({ day: today, left })); } catch {} };
    show();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = q.value.trim();
      if (!text || form.inert) return;
      form.inert = true;
      bubble.textContent = d.wait;
      try {
        const r = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ q: text }) });
        const res = await r.json();
        if (typeof res.left === 'number') { left = res.left; save(); show(); }
        bubble.textContent = res.answer ?? (r.status === 429 ? d.limit : d.err);
        if (res.answer) q.value = '';
      } catch {
        bubble.textContent = d.err;
      }
      form.inert = false;
      q.focus();
    });
  })();
</script>

<style>
  .chat { position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); z-index: 20; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .panel { width: min(360px, calc(100vw - 32px)); background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 16px; display: grid; gap: 12px; box-shadow: 0 24px 60px -20px var(--shadow); animation: pop .18s ease; }
  .panel[hidden], .nudge[hidden] { display: none; }
  h2 { font: 600 16px var(--f-display); letter-spacing: -0.01em; margin: 0; }
  .bubble { max-height: 40vh; overflow-y: auto; background: var(--surface-2); border-radius: 12px; padding: 10px 14px; font-size: 14px; white-space: pre-line; color: var(--fg-2); }
  form { display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 4px 4px 4px 16px; }
  form:focus-within { border-color: var(--accent); }
  form[inert] { opacity: .6; }
  input { flex: 1; min-width: 0; background: none; border: 0; color: var(--fg); font: 400 15px var(--f-body); outline: none; }
  input::placeholder { color: var(--muted); }
  form button { width: 34px; height: 34px; border-radius: 50%; border: 0; background: var(--accent); color: var(--accent-ink); font-weight: 800; }
  .limit { font: 400 11px var(--f-mono); color: var(--muted); }
  .nudge { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 8px 14px; font-size: 14px; box-shadow: 0 14px 30px -10px var(--shadow); animation: pop .25s ease; }
  .fab { width: 56px; height: 56px; border-radius: 50%; border: 0; background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; box-shadow: 0 12px 30px -8px var(--shadow); }
  .fab:hover { filter: brightness(1.08); }
  .fab.call { animation: ring 2.4s ease-out infinite; }
  .fab.call .us { animation: caret 1.2s infinite; }
  @keyframes ring { 0% { box-shadow: 0 12px 30px -8px var(--shadow), 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); } 70%, 100% { box-shadow: 0 12px 30px -8px var(--shadow), 0 0 0 16px transparent; } }
  .fab svg { grid-area: 1 / 1; width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
  .i-x, .fab[aria-expanded="true"] .i-chat { display: none; }
  .fab[aria-expanded="true"] .i-x { display: block; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .panel, .nudge, .fab.call, .fab.call .us { animation: none; } }
</style>
