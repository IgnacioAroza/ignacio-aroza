---
import { siGithub } from 'simple-icons';
import { t, MAIL, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
const f = s.form;
---

<section id="contacto">
  <div class="contact">
    <div class="intro">
      <p class="kicker">{s.kContact}</p>
      <h2>{s.hContact}</h2>
      <p class="sub">{s.subContact}</p>
      <ul class="ways">
        <li>
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z M3 6l9 7 9-7" /></svg></span>
          <div><small>{f.mail}</small><a href={`mailto:${MAIL}`}>{MAIL}</a></div>
          <button class="copy" type="button" data-copy>{s.copy}</button>
        </li>
        <li>
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 24 24" class="fill"><path d={siGithub.path} /></svg></span>
          <div><small>GitHub</small><a href="https://github.com/IgnacioAroza" target="_blank" rel="noopener">IgnacioAroza</a></div>
        </li>
      </ul>
    </div>

    <!-- ponytail: abre el cliente de correo (mailto). Para recibirlo sin que el visitante tenga mail configurado, endpoint con Resend en Vercel. -->
    <form class="card" id="contact-form" data-mail={MAIL} data-subj={f.subj}>
      <label>{f.name}<input name="name" required autocomplete="name" /></label>
      <label>{f.mail}<input name="email" type="email" required autocomplete="email" /></label>
      <label>{f.reason}
        <select name="reason">{f.reasons.map((r) => <option>{r}</option>)}</select>
      </label>
      <label>{f.msg}<textarea name="msg" rows="4" required placeholder={f.msgPh}></textarea></label>
      <button class="btn send" type="submit"><span aria-hidden="true">→</span>{f.send}</button>
    </form>
  </div>
</section>

<script is:inline>
  document.getElementById('contact-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(e.target), { mail, subj } = e.target.dataset;
    const body = `${d.get('msg')}\n\n— ${d.get('name')} <${d.get('email')}>`;
    location.href = `mailto:${mail}?subject=${encodeURIComponent(`${subj}: ${d.get('reason')}`)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: clamp(24px, 5vw, 56px); display: grid; grid-template-columns: 1fr minmax(0, 420px); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .kicker { font: 500 12px var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); margin: 0 0 12px; }
  .sub { margin: 0 0 28px; }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .ways li { display: flex; align-items: center; gap: 14px; }
  .ways div { display: grid; min-width: 0; }
  .ways small { color: var(--muted); font-size: 13px; }
  .ways a { color: var(--fg); text-decoration: none; font-weight: 500; overflow-wrap: anywhere; }
  .ways a:hover { color: var(--accent); }
  .ic { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; flex: none; background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .ic svg { width: 20px; height: 20px; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linejoin: round; }
  .ic svg.fill { fill: var(--accent); stroke: none; }
  .copy { background: none; border: 1px solid var(--line); border-radius: 6px; padding: 4px 10px; font-size: 13px; color: var(--muted); }
  .copy:hover { color: var(--fg); border-color: var(--muted); }

  .card { background: var(--surface-2); border: 1px solid var(--line); border-radius: 16px; padding: clamp(20px, 3vw, 28px); display: grid; gap: 16px; box-shadow: 0 24px 60px -30px #000; }
  label { display: grid; gap: 6px; font-size: 14px; color: var(--muted); }
  input, select, textarea { font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; width: 100%; }
  textarea { resize: vertical; min-height: 96px; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); }
  .send { justify-self: start; display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; padding: 6px 20px 6px 6px; }
  .send span { width: 30px; height: 30px; border-radius: 50%; background: var(--accent-ink); color: var(--accent); display: grid; place-items: center; }

  @media (max-width: 760px) { .contact { grid-template-columns: 1fr; } }
</style>
