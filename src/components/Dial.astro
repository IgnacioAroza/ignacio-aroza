---
import type { Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const items = [
  ['top', lang === 'es' ? 'Inicio' : 'Home'],
  ['proyectos', lang === 'es' ? 'Proyectos' : 'Projects'],
  ['otros', lang === 'es' ? 'Otros' : 'More'],
  ['stack', 'Stack'],
  ['contacto', lang === 'es' ? 'Contacto' : 'Contact'],
];
---

<div class="dial" aria-hidden="false">
  <div class="arc"></div>
  <nav aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
    {items.map(([id, label], i) => (
      <a class="it" href={`#${id}`} data-id={id}>
        <span class="in"><i class="dot"></i><b>{String(i + 1).padStart(2, '0')}</b><em>{label}</em></span>
      </a>
    ))}
  </nav>
</div>

<script>
  // El scroll se traduce a un índice fraccionario p (0 = Inicio ... 4 = Contacto); cada ítem se acomoda en el arco según su distancia a p.
  const R = 240, STEP = 17;
  const dial = document.querySelector<HTMLElement>('.dial')!;
  const its = [...dial.querySelectorAll<HTMLElement>('.it')];
  const secs = its.map((a) => document.getElementById(a.dataset.id!)!);

  const place = () => {
    const y = scrollY + innerHeight * 0.4;
    const tops = secs.map((s) => s.getBoundingClientRect().top + scrollY);
    let p = 0;
    for (let k = 0; k < tops.length - 1; k++) if (y >= tops[k]) p = k + Math.min(1, (y - tops[k]) / (tops[k + 1] - tops[k]));
    if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) p = tops.length - 1;
    its.forEach((a, i) => {
      const d = i - p, ad = Math.abs(d);
      a.style.transform = `rotate(${d * STEP}deg) translate(${R}px, -50%)`;
      a.style.opacity = String(Math.max(0, 1 - Math.max(0, ad - 0.3) * 0.45));
      a.style.setProperty('--s', String(Math.max(0.5, 1.3 - ad * 0.5)));
      a.style.setProperty('--on', String(Math.max(0, 1 - ad * 2)));
      a.style.pointerEvents = ad > 2.3 ? 'none' : 'auto';
      a.toggleAttribute('data-active', ad < 0.5);
    });
  };
  addEventListener('scroll', place, { passive: true });
  addEventListener('resize', place);
  place();
</script>

<style>
  .dial { display: none; position: fixed; inset: 0 auto 0 0; width: 0; z-index: 10; pointer-events: none; }
  .arc { position: absolute; top: 50vh; left: calc(14px - 480px); width: 480px; height: 480px; margin-top: -240px; border: 1px solid var(--line); border-radius: 50%; }
  nav { position: absolute; top: 50vh; left: calc(14px - 240px); width: 0; height: 0; }
  .it { position: absolute; left: 0; top: 0; transform-origin: 0 0; text-decoration: none; color: var(--muted); display: block; will-change: transform, opacity; }
  .in { display: flex; align-items: center; gap: 12px; transform: scale(var(--s, 1)); transform-origin: 0 50%; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line); margin-left: -4px; flex: none; }
  b { font: 500 22px/1 var(--f-mono); }
  em { display: none; font: 500 14px var(--f-body); font-style: normal; opacity: var(--on, 0); white-space: nowrap; }
  .it[data-active] { color: var(--fg); }
  .it[data-active] .dot { background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .it:hover { color: var(--fg); }

  @media (min-width: 1360px) and (prefers-reduced-motion: no-preference) { .dial { display: block; } }
  @media (min-width: 1600px) { em { display: block; } }
</style>
