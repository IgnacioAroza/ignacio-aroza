---
import { t, MAIL, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
const prompt = 'ignacio@aroza ~ >';
---

<header class="hero" id="top">
  <div>
    <div class="status"><span><b>sistema:ignacio-aroza</b></span><span><i class="dot"></i>{s.open}</span></div>
    <h1>Ignacio<br />Aroza<span class="caret" aria-hidden="true"></span></h1>
    <div class="kicker">{s.kicker}</div>
    <p class="role">{s.role}</p>
    <p class="lede">{s.lede}</p>
    <div class="cta">
      <a class="btn" href={`/cv-${lang}.pdf`} download>{s.cv}</a>
      <button class="btn ghost" type="button" data-copy>{s.write}</button>
    </div>
    <div class="copied" id="copied" role="status"></div>
  </div>

  <div class="stage" id="stage">
    <div class="halo"></div>
    <div class="rig" id="rig">
      <div class="monitor">
        <div class="bezel">
          <div class="screen">
            <div class="term-body" aria-live="polite">
              {Object.keys(s.tabs).map((k, i) => (
                <div class="fade" data-panel={k} hidden={i > 0}>
                  <span class="p">{prompt}</span> {s.tabs[k as keyof typeof s.tabs]}
                  {k === 'whoami' && <span class="out">{s.who}</span>}
                  {k === 'stack' && <ul>{s.stack.map((x) => <li>{x}</li>)}</ul>}
                  {k === 'proyectos' && <ul>{s.proy.map((x) => <li>{x}</li>)}</ul>}
                  {k === 'contacto' && <span class="out">{s.cont}</span>}
                  <br /><span class="p">{prompt}</span> <span class="caret" style="width:.55em;height:1em"></span>
                </div>
              ))}
            </div>
            <div class="tabs" role="tablist">
              <span class="ws">[ia]</span>
              {Object.entries(s.tabs).map(([k, label], i) => (
                <button type="button" role="tab" data-tab={k} aria-selected={i === 0 ? 'true' : 'false'}>{i}:{label}</button>
              ))}
            </div>
          </div>
        </div>
        <div class="neck"></div><div class="foot"></div>
      </div>
      <button class="lamp" id="lamp" type="button" aria-pressed="false" aria-label={s.lampOn}><i class="shade"></i><i class="arm"></i><i class="base"></i></button>
      <span class="hint" id="hint" aria-hidden="true">↑ {s.lampHint}</span>
      <div class="laptop">
        <div class="lscreen">
          <div class="screen">
            <div class="term-body">
              <span class="c">$ ls ~/portfolio</span>
              <ul class="nav-list">
                {s.links.map(([id, label, key]) => (
                  <li><a href={`#${id}`}><span>{label}</span><span>{key}</span></a></li>
                ))}
                <li><a href={`/cv-${lang}.pdf`} download><span>~/cv.pdf</span><span>↓</span></a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="deck"></div>
      </div>
      <div class="desk"></div>
    </div>
    <button class="toggle3d" type="button" id="toggle3d" aria-pressed="false">{s.off3d}</button>
  </div>
</header>

<script is:inline define:vars={{ MAIL, copiedTxt: s.copied, on3d: s.on3d, off3d: s.off3d, lampOn: s.lampOn, lampOff: s.lampOff }}>
  const $ = (q) => document.querySelector(q);
  const stage = $('#stage'), rig = $('#rig'), toggle = $('#toggle3d');

  document.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', x === b));
    document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
  }));

  const setFlat = (v) => {
    stage.classList.toggle('flat', v);
    toggle.setAttribute('aria-pressed', v);
    toggle.textContent = v ? on3d : off3d;
    rig.style.setProperty('--rx', '0deg'); rig.style.setProperty('--ry', '0deg');
  };
  toggle.addEventListener('click', () => setFlat(!stage.classList.contains('flat')));
  if (matchMedia('(max-width: 900px)').matches) setFlat(true);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  stage.addEventListener('pointermove', (e) => {
    if (reduce || stage.classList.contains('flat')) return;
    const r = stage.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
    rig.style.setProperty('--ry', (x * 10).toFixed(2) + 'deg');
    rig.style.setProperty('--rx', (-y * 6).toFixed(2) + 'deg');
  });
  stage.addEventListener('pointerleave', () => { rig.style.setProperty('--rx', '0deg'); rig.style.setProperty('--ry', '0deg'); });

  // Siempre arranca apagada (modo oscuro). Al prender, la luz se expande desde la lámpara como una vista de transición.
  const lamp = $('#lamp'), root = document.documentElement;
  lamp.addEventListener('click', () => {
    const on = root.dataset.theme !== 'light';
    const apply = () => {
      if (on) root.dataset.theme = 'light'; else delete root.dataset.theme;
      lamp.setAttribute('aria-pressed', on);
      lamp.setAttribute('aria-label', on ? lampOff : lampOn);
      $('#hint').hidden = true;
    };
    if (reduce || !document.startViewTransition) return apply();
    const r = lamp.querySelector('.shade').getBoundingClientRect();
    const x = r.left + r.width / 2, y = r.top + r.height / 2;
    const rad = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.startViewTransition(apply).ready.then(() => root.animate(
      { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${rad}px at ${x}px ${y}px)`] },
      { duration: 900, easing: 'ease-out', pseudoElement: '::view-transition-new(root)' }
    ));
  });

  document.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => {
    const label = b.textContent;
    const done = () => {
      $('#copied').textContent = b.textContent = copiedTxt;
      setTimeout(() => { $('#copied').textContent = ''; b.textContent = label; }, 2000);
    };
    navigator.clipboard ? navigator.clipboard.writeText(MAIL).then(done, done) : done();
  }));
</script>

<style>
/* hero */
.hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 56px); align-items: center; padding-block: 24px 64px; }
.status { font: 400 13px var(--f-mono); color: var(--muted); display: flex; gap: 8px 16px; flex-wrap: wrap; align-items: center; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
.status b { color: var(--accent); font-weight: 500; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: #5fd49a; display: inline-block; margin-right: 6px; }
h1 { font: 800 clamp(44px, 7.4vw, 92px)/.94 var(--f-display); letter-spacing: -0.035em; margin: 28px 0 0; text-wrap: balance; }
h1 .caret { margin-left: .08em; }
.kicker { font: 500 16px var(--f-body); color: var(--accent); margin-top: 24px; }
.role { font: 600 clamp(21px, 2.4vw, 29px)/1.22 var(--f-display); letter-spacing: -0.015em; color: var(--fg); margin: 12px 0 0; max-width: 28ch; text-wrap: balance; }
.lede { font: 400 17px/1.55 var(--f-body); color: var(--muted); margin: 18px 0 0; max-width: 44ch; text-wrap: pretty; }
.cta { display: flex; gap: 12px 20px; flex-wrap: wrap; margin-top: 32px; align-items: center; }
.copied { font: 400 12px var(--f-mono); color: var(--muted); min-height: 18px; margin-top: 10px; }
/* escena */
.stage { container-type: inline-size; position: relative; width: 100%; max-width: 760px; margin-inline: auto; aspect-ratio: 8 / 7.4; perspective: 1500px; --u: 1cqw; }
.stage .halo { position: absolute; inset: -6% -6% -2%; background: radial-gradient(70% 60% at 40% 45%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%); pointer-events: none; }
:global(:root[data-theme="light"]) .stage .halo { background: radial-gradient(65% 60% at 80% 55%, color-mix(in srgb, var(--lamp) 38%, transparent), transparent 72%); }
.rig { position: absolute; inset: 0; transform-style: preserve-3d; transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .25s ease-out; }
.monitor { position: absolute; left: calc(var(--u) * 8); top: calc(var(--u) * 2); width: calc(var(--u) * 84); height: calc(var(--u) * 47); transform: translateZ(-50px); }
.bezel { position: absolute; inset: 0 0 calc(var(--u) * 5) 0; background: #05070b; border: 1px solid #202a3a; border-radius: calc(var(--u) * 1.4); padding: calc(var(--u) * 1); box-shadow: 0 30px 60px -20px #000, inset 0 0 0 1px #0f1521; }
.neck { position: absolute; left: 50%; bottom: calc(var(--u) * 1); width: calc(var(--u) * 5); height: calc(var(--u) * 4.2); translate: -50% 0; background: linear-gradient(#1a2230, #0f1521); }
.foot { position: absolute; left: 50%; bottom: 0; width: calc(var(--u) * 20); height: calc(var(--u) * 1.2); translate: -50% 0; background: #1a2230; border-radius: 4px; }
.screen { --fg: #e6eaf2; --muted: #8b97ad; --accent: #7cb7ff; --accent-ink: #06121f; width: 100%; height: 100%; background: #0a0e14; border-radius: calc(var(--u) * .7); overflow: hidden; font-family: var(--f-mono); color: var(--fg); display: flex; flex-direction: column; position: relative; }
.screen::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0,0,0,.14) 2px 3px), linear-gradient(115deg, rgba(255,255,255,.05), transparent 35%); }
.term-body { flex: 1; padding: calc(var(--u) * 1.8) calc(var(--u) * 2.2); font-size: calc(var(--u) * 1.85); line-height: 1.6; overflow: hidden; }
.term-body .p { color: var(--accent); }
.term-body .c { color: var(--muted); }
.term-body .out { display: block; margin-top: calc(var(--u) * .6); color: #cfd6e4; font-family: var(--f-body); font-size: calc(var(--u) * 2.1); line-height: 1.5; text-wrap: pretty; }
.term-body ul { margin: calc(var(--u) * .6) 0 0; padding: 0; list-style: none; font-size: calc(var(--u) * 2); }
.term-body li::before { content: "› "; color: var(--accent); }
.term-body .nav-list li::before { content: none; }
.fade { animation: fade .25s ease; }
@keyframes fade { from { opacity: 0; transform: translateY(3px); } to { opacity: 1; transform: none; } }
.tabs { display: flex; gap: calc(var(--u) * .6); padding: calc(var(--u) * .9) calc(var(--u) * 1.4); border-top: 1px solid #1b2536; background: #0e141d; flex-wrap: wrap; position: relative; z-index: 2; }
.tabs button { background: none; border: 0; font: 400 calc(var(--u) * 1.6)/1 var(--f-mono); color: var(--muted); padding: calc(var(--u) * .8) calc(var(--u) * 1.1); border-radius: 4px; }
.tabs button[aria-selected="true"] { color: var(--accent-ink); background: var(--accent); }
.tabs button:hover:not([aria-selected="true"]) { color: var(--fg); }
.tabs .ws { color: var(--accent); align-self: center; font-size: calc(var(--u) * 1.6); padding-right: calc(var(--u) * .6); }
.laptop { position: absolute; left: calc(var(--u) * 24); top: calc(var(--u) * 54); width: calc(var(--u) * 52); transform: translateZ(40px); }
.lscreen { height: calc(var(--u) * 26); background: #05070b; border: 1px solid #202a3a; border-radius: calc(var(--u) * 1.2) calc(var(--u) * 1.2) 0 0; padding: calc(var(--u) * .8); box-shadow: 0 20px 40px -18px #000; }
.lscreen .screen { border-radius: calc(var(--u) * .6); }
.lscreen .term-body { padding: calc(var(--u) * 1.2) calc(var(--u) * 1.8); line-height: 1.4; }
.lscreen .nav-list a { padding-block: calc(var(--u) * .5); }
.nav-list { display: grid; gap: calc(var(--u) * .5); margin: calc(var(--u) * .8) 0 0; padding: 0; list-style: none; position: relative; z-index: 2; }
.nav-list a { display: flex; justify-content: space-between; align-items: center; text-decoration: none; font-size: calc(var(--u) * 2.1); padding: calc(var(--u) * .7) calc(var(--u) * 1.1); border: 1px solid #1b2536; border-radius: 6px; background: #0e141d; }
.nav-list a span:last-child { color: var(--muted); }
.nav-list a:hover { border-color: var(--accent); color: var(--accent); }
.deck { height: calc(var(--u) * 7); background: linear-gradient(#222c3d, #151c28); clip-path: polygon(3% 0, 97% 0, 100% 100%, 0 100%); position: relative; }
.deck::before { content: ""; position: absolute; inset: calc(var(--u) * 1) calc(var(--u) * 5) calc(var(--u) * 2.4); background: repeating-linear-gradient(90deg, #0b1018 0 calc(var(--u) * 2.2), transparent calc(var(--u) * 2.2) calc(var(--u) * 2.5)); mask: repeating-linear-gradient(0deg, #000 0 calc(var(--u) * 1.1), transparent calc(var(--u) * 1.1) calc(var(--u) * 1.4)); opacity: .9; }
.deck::after { content: ""; position: absolute; left: 50%; bottom: calc(var(--u) * .4); width: calc(var(--u) * 9); height: calc(var(--u) * 1.3); translate: -50% 0; background: #1b2434; border-radius: 3px; }
.lamp { position: absolute; right: calc(var(--u) * 3); top: calc(var(--u) * 52); width: calc(var(--u) * 10); height: calc(var(--u) * 16); transform: translateZ(10px); background: none; border: 0; padding: 0; cursor: pointer; animation: beckon 2.4s ease-in-out infinite; }
.lamp:hover .shade { background: color-mix(in srgb, var(--lamp) 55%, #4a5266); }
.hint { position: absolute; right: calc(var(--u) * 1); top: calc(var(--u) * 69); transform: translateZ(10px); font: 400 max(11px, calc(var(--u) * 1.6)) var(--f-mono); color: var(--lamp); white-space: nowrap; animation: beckon-text 2.4s ease-in-out infinite; }
.hint[hidden] { display: none; }
@keyframes beckon { 0%, 100% { filter: drop-shadow(0 0 0 transparent); } 50% { filter: drop-shadow(0 0 12px color-mix(in srgb, var(--lamp) 55%, transparent)); } }
@keyframes beckon-text { 0%, 100% { opacity: .45; } 50% { opacity: 1; } }
:global(:root[data-theme="light"]) .lamp { animation: none; filter: drop-shadow(0 0 22px color-mix(in srgb, var(--lamp) 90%, transparent)); }
:global(:root[data-theme="light"]) .lamp .shade { background: var(--lamp); }
.lamp i { position: absolute; left: 50%; translate: -50% 0; }
.lamp .shade { top: 0; width: calc(var(--u) * 8); height: calc(var(--u) * 6); background: #4a5266; clip-path: polygon(18% 0, 82% 0, 100% 100%, 0 100%); transition: background .4s; }
.lamp .arm { top: calc(var(--u) * 6); width: calc(var(--u) * .7); height: calc(var(--u) * 7); background: #2a3447; }
.lamp .base { top: calc(var(--u) * 13); width: calc(var(--u) * 6); height: calc(var(--u) * 1); background: #2a3447; border-radius: 3px; }
.desk { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--u) * 4); background: linear-gradient(var(--surface-2), var(--bg)); border-top: 1px solid var(--line); transform: translateZ(0); }
.toggle3d { position: absolute; right: 8px; bottom: 8px; z-index: 5; font: 400 12px var(--f-mono); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
.toggle3d:hover { border-color: var(--accent); }
.stage:not(.flat) .toggle3d { right: 0; bottom: -44px; }
/* modo plano (sin 3D / móvil) */
.stage.flat { aspect-ratio: auto; perspective: none; --u: 6.4px; max-width: 640px; display: grid; gap: 14px; padding-bottom: 84px; }
.stage.flat .rig { position: relative; transform: none; display: grid; gap: 14px; }
.stage.flat .halo, .stage.flat .desk, .stage.flat .neck, .stage.flat .foot, .stage.flat .deck { display: none; }
.stage.flat .monitor, .stage.flat .laptop { position: static; width: auto; height: auto; transform: none; }
.stage.flat .bezel { position: static; height: auto; padding: 6px; }
.stage.flat .screen { min-height: 220px; }
.stage.flat .lscreen { height: auto; border-radius: 12px; padding: 6px; }
.stage.flat .lscreen .screen { min-height: 0; }
.stage.flat .lamp { --u: 3.6px; position: absolute; top: calc(100% + 14px); right: auto; bottom: auto; left: 8px; transform: none; z-index: 5; }
.stage.flat .hint { top: calc(100% + 30px); right: auto; bottom: auto; left: 56px; transform: none; font-size: 11px; z-index: 5; }
@media (max-width: 900px) {
  .hero { grid-template-columns: minmax(0, 1fr); }
}
@media (prefers-reduced-motion: reduce) {
  .fade { animation: none; }
  .rig { transition: none; }
  .lamp, .hint { animation: none; }
}
</style>
