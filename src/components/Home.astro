---
import '../styles/global.css';
import { t, MAIL, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
const prompt = 'ignacio@aroza ~ >';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{s.title}</title>
    <meta name="description" content={s.role} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a class="logo" href="#top" aria-label="Ignacio Aroza">I<span class="caret"></span>A</a>
        <div class="links">
          <a href="#proyectos">{s.nav.proyectos}</a>
          <a href="#otros">{s.nav.otros}</a>
          <a href="#contacto">{s.nav.contacto}</a>
        </div>
        <div class="seg" role="group" aria-label="Idioma">
          <a href="/" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
      </nav>

      <header class="hero" id="top">
        <div>
          <div class="status"><span><b>sistema:ignacio-aroza</b></span><span><i class="dot"></i>{s.open}</span></div>
          <h1>Ignacio<br />Aroza<span class="caret" aria-hidden="true"></span></h1>
          <div class="kicker">{s.kicker}</div>
          <p class="role">{s.role}</p>
          <p class="lede">{s.lede}</p>
          <div class="cta">
            <a class="btn" href={`/cv-${lang}.pdf`} download>{s.cv}</a>
            <button class="btn ghost" type="button" data-copy>{s.write}</button>
          </div>
          <div class="copied" id="copied" role="status"></div>
        </div>

        <div class="stage" id="stage">
          <div class="halo"></div>
          <div class="rig" id="rig">
            <div class="monitor">
              <div class="bezel">
                <div class="screen">
                  <div class="term-body" aria-live="polite">
                    {Object.keys(s.tabs).map((k, i) => (
                      <div class="fade" data-panel={k} hidden={i > 0}>
                        <span class="p">{prompt}</span> {s.tabs[k as keyof typeof s.tabs]}
                        {k === 'whoami' && <span class="out">{s.who}</span>}
                        {k === 'stack' && <ul>{s.stack.map((x) => <li>{x}</li>)}</ul>}
                        {k === 'proyectos' && <ul>{s.proy.map((x) => <li>{x}</li>)}</ul>}
                        {k === 'contacto' && <span class="out">{s.cont}</span>}
                        <br /><span class="p">{prompt}</span> <span class="caret" style="width:.55em;height:1em"></span>
                      </div>
                    ))}
                  </div>
                  <div class="tabs" role="tablist">
                    <span class="ws">[ia]</span>
                    {Object.entries(s.tabs).map(([k, label], i) => (
                      <button type="button" role="tab" data-tab={k} aria-selected={i === 0 ? 'true' : 'false'}>{i}:{label}</button>
                    ))}
                  </div>
                </div>
              </div>
              <div class="neck"></div><div class="foot"></div>
            </div>
            <div class="lamp" aria-hidden="true"><i class="shade"></i><i class="arm"></i><i class="base"></i></div>
            <div class="laptop">
              <div class="lscreen">
                <div class="screen">
                  <div class="term-body">
                    <span class="c">$ ls ~/portfolio</span>
                    <ul class="nav-list">
                      {s.links.map(([id, label, key]) => (
                        <li><a href={`#${id}`}><span>{label}</span><span>{key}</span></a></li>
                      ))}
                      <li><a href={`/cv-${lang}.pdf`} download><span>~/cv.pdf</span><span>↓</span></a></li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="deck"></div>
            </div>
            <div class="desk"></div>
          </div>
          <button class="toggle3d" type="button" id="toggle3d" aria-pressed="false">{s.off3d}</button>
        </div>
      </header>
    </div>

    <script is:inline define:vars={{ MAIL, copiedTxt: s.copied, on3d: s.on3d, off3d: s.off3d }}>
      const $ = (q) => document.querySelector(q);
      const stage = $('#stage'), rig = $('#rig'), toggle = $('#toggle3d');

      document.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => {
        document.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', x === b));
        document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.tab));
      }));

      const setFlat = (v) => {
        stage.classList.toggle('flat', v);
        toggle.setAttribute('aria-pressed', v);
        toggle.textContent = v ? on3d : off3d;
        rig.style.setProperty('--rx', '0deg'); rig.style.setProperty('--ry', '0deg');
      };
      toggle.addEventListener('click', () => setFlat(!stage.classList.contains('flat')));
      if (matchMedia('(max-width: 900px)').matches) setFlat(true);

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      stage.addEventListener('pointermove', (e) => {
        if (reduce || stage.classList.contains('flat')) return;
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        rig.style.setProperty('--ry', (x * 10).toFixed(2) + 'deg');
        rig.style.setProperty('--rx', (-y * 6).toFixed(2) + 'deg');
      });
      stage.addEventListener('pointerleave', () => { rig.style.setProperty('--rx', '0deg'); rig.style.setProperty('--ry', '0deg'); });

      document.querySelectorAll('[data-copy]').forEach((b) => b.addEventListener('click', () => {
        const done = () => { $('#copied').textContent = copiedTxt; setTimeout(() => ($('#copied').textContent = ''), 2000); };
        navigator.clipboard ? navigator.clipboard.writeText(MAIL).then(done, done) : done();
      }));
    </script>
  </body>
</html>
