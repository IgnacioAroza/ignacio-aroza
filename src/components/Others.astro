---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
---

<section id="otros">
  <h2>{s.hOther}</h2>
  <p class="sub">{s.subOther}</p>
  <div class="rows">
    {s.others.map((o) => (
      <details><summary><b>{o.name}</b><small>{o.meta}</small></summary><p>{o.desc}</p></details>
    ))}
  </div>
</section>

<style>
.rows { border-top: 1px solid var(--line); }
details { border-bottom: 1px solid var(--line); }
summary { list-style: none; display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: 18px 4px; cursor: pointer; }
summary::-webkit-details-marker { display: none; }
summary::before { content: "▸"; color: var(--accent); transition: rotate .2s; }
details[open] summary::before { rotate: 90deg; }
summary b { font: 600 22px/1.2 var(--f-display); letter-spacing: -0.01em; }
summary small { font: 400 12px var(--f-mono); color: var(--muted); }
summary:hover b { color: var(--accent); }
details p { margin: 0 0 18px 40px; color: #b9c3d6; max-width: 62ch; }
@media (max-width: 900px) {
  summary { grid-template-columns: 20px minmax(0, 1fr); }
  summary small { grid-column: 2; }
  details p { margin-left: 32px; }
}
</style>
