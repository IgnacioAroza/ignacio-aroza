---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
---

<section id="proyectos">
  <h2>{s.hProj}</h2>
  <p class="sub">{s.subProj}</p>
  <div class="cases">
    {s.cases.map((c) => (
      <article class="case">
        <div class="shot">
          <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
          {c.img ? (
            <button class="vp" type="button" data-full={c.img} data-alt={c.name} aria-label={`${s.zoom}: ${c.name}`}
              style={`--w:${(1920 / c.crop[2]) * 100}%;--l:${(c.crop[0] / c.crop[2]) * 100}%;--t:${(c.crop[1] / c.crop[2]) * 100}%`}>
              <img src={c.img} alt="" loading="lazy" />
              <span class="more" aria-hidden="true">{s.zoom}</span>
            </button>
          ) : (
            <div class="vp"><div class="ui"><i></i><div><i></i><i></i><i></i></div></div><em>{s.shot}</em></div>
          )}
        </div>
        <div class="tag">{c.tag}</div>
        <h3>{c.name}</h3>
        <p>{c.desc}</p>
        <ul class="chips">{c.chips.map((x) => <li>{x}</li>)}</ul>
      </article>
    ))}
  </div>
  <dialog id="shot-modal" aria-label={s.zoom}>
    <button class="x" type="button" aria-label={s.closeShot}>×</button>
    <img alt="" />
  </dialog>
</section>

<script>
  // El recorte se hace con CSS (--w/--l/--t salen de `crop` en i18n.ts); el modal muestra el archivo original completo.
  const modal = document.getElementById('shot-modal') as HTMLDialogElement;
  const full = modal.querySelector('img')!;
  document.querySelectorAll<HTMLElement>('[data-full]').forEach((b) => b.addEventListener('click', () => {
    full.src = b.dataset.full!;
    full.alt = b.dataset.alt!;
    modal.showModal();
  }));
  modal.addEventListener('click', () => modal.close());
</script>

<style>
.cases { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 48px; }
.case { display: grid; gap: 14px; min-width: 0; align-content: start; }
.shot { display: grid; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); overflow: hidden;;
  box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 8%, transparent), 0 30px 60px -28px var(--shadow), 0 8px 20px -12px var(--shadow); }
.bar { display: flex; gap: 6px; padding: 9px 12px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
.bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
.vp { aspect-ratio: 2 / 1; position: relative; overflow: hidden; display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; }
button.vp { cursor: zoom-in; }
.vp img { display: block; width: var(--w); max-width: none; height: auto; margin-left: calc(var(--l) * -1); margin-top: calc(var(--t) * -1); }
.more { position: absolute; right: 10px; bottom: 10px; font: 500 12px var(--f-body); color: var(--fg); background: color-mix(in srgb, var(--bg) 80%, transparent); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; }
dialog { margin: auto; padding: 0; border: 0; background: none; max-width: 94vw; max-height: 94vh; overflow: visible; }
dialog::backdrop { background: rgb(0 0 0 / .75); }
dialog img { display: block; max-width: 94vw; max-height: 90vh; border-radius: 10px; box-shadow: 0 30px 80px -20px #000; }
dialog .x { position: absolute; top: -14px; right: -14px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); color: var(--fg); font-size: 20px; line-height: 1; }
.case:hover h3 { color: var(--accent); }
.case h3 { transition: color .2s; }
.vp .ui { position: absolute; inset: 14% 8%; display: grid; grid-template-columns: 22% 1fr; gap: 8px; }
.vp .ui > i, .vp .ui > div > i { background: var(--surface-2); border-radius: 6px; }
.vp .ui > div { display: grid; grid-template-rows: 18% 1fr 1fr; gap: 8px; }
.vp .ui > div > i:first-child { background: color-mix(in srgb, var(--accent) 22%, var(--surface-2)); }
.vp em { position: absolute; left: 12px; bottom: 10px; font: 400 11px var(--f-mono); color: var(--muted); font-style: normal; }
.tag { font: 500 14px var(--f-body); color: var(--accent); }
.case h3 { font: 800 26px/1.1 var(--f-display); letter-spacing: -0.02em; margin: 0; }
.case p { margin: 0; color: var(--fg-2); max-width: 56ch; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; padding: 0; margin: 0; list-style: none; }
.chips li { font: 400 12px var(--f-mono); color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; }
@media (max-width: 900px) {
  .cases { grid-template-columns: minmax(0, 1fr); }
}
</style>
