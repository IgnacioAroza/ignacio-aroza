---
// Select propio (patrón ARIA "select-only combobox"): el nativo no se puede estilizar. Un <input hidden> lleva el valor al FormData.
interface Props { name: string; options: string[]; labelledby: string }
const { name, options, labelledby } = Astro.props;
const id = `sel-${name}`;
---

<div class="sel" data-sel>
  <input type="hidden" name={name} value={options[0]} />
  <button type="button" class="trigger" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-list`} aria-labelledby={labelledby} aria-activedescendant={`${id}-0`}>
    <span>{options[0]}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
  </button>
  <ul role="listbox" id={`${id}-list`} aria-labelledby={labelledby} hidden>
    {options.map((o, i) => <li role="option" id={`${id}-${i}`} aria-selected={i === 0 ? 'true' : 'false'} class:list={{ active: i === 0 }}>{o}</li>)}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sel]').forEach((root) => {
    const input = root.querySelector('input')!, btn = root.querySelector('button')!, list = root.querySelector('ul')!;
    const opts = [...list.children] as HTMLElement[];
    let cur = 0;
    const open = (v: boolean) => { list.hidden = !v; btn.setAttribute('aria-expanded', String(v)); };
    const mark = (i: number) => {
      cur = i;
      opts.forEach((o, j) => o.classList.toggle('active', j === i));
      btn.setAttribute('aria-activedescendant', opts[i].id);
    };
    const pick = (i: number) => {
      input.value = opts[i].textContent!.trim();
      btn.firstElementChild!.textContent = input.value;
      opts.forEach((o, j) => o.setAttribute('aria-selected', String(j === i)));
      mark(i);
    };
    btn.addEventListener('click', () => open(list.hidden));
    btn.addEventListener('keydown', (e) => {
      const k = e.key;
      if (list.hidden) {
        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(k)) { e.preventDefault(); open(true); }
        return;
      }
      if (k === 'ArrowDown') mark(Math.min(cur + 1, opts.length - 1));
      else if (k === 'ArrowUp') mark(Math.max(cur - 1, 0));
      else if (k === 'Home') mark(0);
      else if (k === 'End') mark(opts.length - 1);
      else if (k === 'Enter' || k === ' ') pick(cur), open(false);
      else if (k === 'Escape') open(false);
      else if (k === 'Tab') open(false);
      else return;
      if (k !== 'Tab') e.preventDefault();
    });
    list.addEventListener('click', (e) => {
      const i = opts.indexOf((e.target as HTMLElement).closest('li')!);
      if (i < 0) return;
      pick(i); open(false); btn.focus();
    });
    list.addEventListener('pointermove', (e) => {
      const i = opts.indexOf((e.target as HTMLElement).closest('li')!);
      if (i >= 0) mark(i);
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) open(false); });
    root.closest('form')?.addEventListener('reset', () => pick(0));
  });
</script>

<style>
  .sel { position: relative; }
  .trigger { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; text-align: left; font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
  .trigger:hover { border-color: var(--muted); }
  .trigger[aria-expanded="true"], .trigger:focus-visible { border-color: var(--accent); outline: none; }
  .trigger svg { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: rotate .2s; }
  .trigger[aria-expanded="true"] svg { rotate: 180deg; }
  ul { position: absolute; z-index: 30; inset: calc(100% + 6px) 0 auto; margin: 0; padding: 4px; list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 18px 40px -12px var(--shadow); animation: pop .15s ease; }
  ul[hidden] { display: none; }
  li { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 10px; border-radius: 6px; color: var(--fg); cursor: pointer; }
  li.active { background: color-mix(in srgb, var(--accent) 16%, transparent); }
  li[aria-selected="true"] { color: var(--accent); }
  li[aria-selected="true"]::after { content: ""; width: 12px; height: 6px; flex: none; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; rotate: -45deg; translate: 0 -2px; }
  @keyframes pop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { ul { animation: none; } .trigger svg { transition: none; } }
</style>
