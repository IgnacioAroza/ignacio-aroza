---
import * as si from 'simple-icons';
import { t, STACK, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];

const icon = (slug: string) => (si as Record<string, { path: string }>)['si' + slug[0]?.toUpperCase() + slug.slice(1)];
---

<section id="stack">
  <h2>{s.hStack}</h2>
  <p class="sub">{s.subStack}</p>
  {Object.entries(STACK).map(([group, items]) => (
    <>
      <h3 class="stack-h">{s.stackGroups[group as keyof typeof STACK]}</h3>
      <ul class="stack">
        {items.map(([name, slug]) => {
          const i = slug && icon(slug);
          return (
            <li>
              {i ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d={i.path} /></svg> : <span class="mono" aria-hidden="true">{name.length <= 3 ? name : name.match(/[A-Z]/g)?.slice(0, 2).join('').padEnd(2, name[1])}</span>}
              {name}
            </li>
          );
        })}
      </ul>
    </>
  ))}
</section>

<style>
#stack { display: grid; grid-template-columns: 140px minmax(0, 1fr); column-gap: 32px; }
#stack > h2, #stack > .sub { grid-column: 1 / -1; }
.stack-h, .stack { margin: 0; padding-block: 14px; border-top: 1px solid var(--line); }
.stack-h { font: 500 14px var(--f-body); color: var(--accent); }
.stack { list-style: none; padding-inline: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 2px 8px; align-content: start; }
.stack li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid transparent; border-radius: 10px; font: 500 14px var(--f-body); }
.stack svg { width: 20px; height: 20px; fill: var(--fg-2); flex: none; }
.stack .mono { width: 20px; height: 20px; flex: none; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 4px; font: 600 9px var(--f-mono); color: var(--fg-2); }
.stack li:hover { border-color: var(--line); background: var(--surface); }
.stack li:hover svg { fill: var(--fg); }
@media (max-width: 700px) {
  #stack { display: block; }
  .stack-h { border: 0; padding: 20px 0 6px; }
  .stack { border: 0; padding-top: 0; }
}
</style>
