---
import '../styles/global.css';
import { t, type Lang } from '../i18n';
import Chat from '../components/Chat.astro';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{s.title}</title>
    <meta name="description" content={s.role} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a class="logo" href="#top" aria-label="Ignacio Aroza">I<span class="caret"></span>A</a>
        <div class="links">
          <a href="#proyectos">{s.nav.proyectos}</a>
          <a href="#otros">{s.nav.otros}</a>
          <a href="#contacto">{s.nav.contacto}</a>
        </div>
        <div class="seg" role="group" aria-label="Idioma">
          <a href="/" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
          <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
      </nav>
      <slot />
    </div>
    <Chat lang={lang} />
  </body>
</html>

<style>
nav { display: flex; align-items: center; gap: 24px; padding-block: 20px; flex-wrap: wrap; }
.logo { display: inline-flex; align-items: center; font: 800 22px/1 var(--f-display); letter-spacing: -0.02em; text-decoration: none; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }
.logo .caret { width: 3px; height: 20px; margin-inline: 3px; box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 60%, transparent); }
.links { display: flex; gap: 22px; margin-left: 8px; flex-wrap: wrap; }
.links a { color: var(--muted); text-decoration: none; font-size: 15px; }
.links a:hover { color: var(--fg); }
.seg { margin-left: auto; display: flex; gap: 4px; font: 500 13px var(--f-mono); }
.seg a { text-decoration: none; border: 1px solid transparent; padding: 4px 8px; border-radius: 6px; color: var(--muted); }
.seg a[aria-current] { color: var(--fg); border-color: var(--line); background: var(--surface); }
@media (max-width: 900px) {
  .seg, .links { margin-left: 0; }
}
</style>
