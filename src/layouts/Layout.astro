---
import '../styles/global.css';
import { t, type Lang } from '../i18n';
import Chat from '../components/Chat.astro';
import Dial from '../components/Dial.astro';
import Rain from '../components/Rain.astro';

const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{s.title}</title>
    <meta name="description" content={s.role} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a class="logo" href="#top" aria-label="Ignacio Aroza">I<span class="caret"></span>A</a>
        <div class="links">
          <a href="#proyectos">{s.nav.proyectos}</a>
          <a href="#otros">{s.nav.otros}</a>
          <a href="#contacto">{s.nav.contacto}</a>
        </div>
        <a class="sw" href={lang === 'es' ? '/en/' : '/'} data-lang={lang} aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a español'}>
          <span>ES</span><span>EN</span><i>{lang.toUpperCase()}</i>
        </a>
      </nav>
      <slot />
    </div>
    <Rain />
    <Dial lang={lang} />
    <Chat lang={lang} />
  </body>
</html>

<script>
  // El knob se desliza antes de navegar al otro idioma.
  const sw = document.querySelector<HTMLAnchorElement>('.sw')!;
  sw.addEventListener('click', (e) => {
    e.preventDefault();
    sw.classList.add('flip');
    setTimeout(() => (location.href = sw.href), 180);
  });
</script>

<style>
nav { display: flex; align-items: center; gap: 24px; padding-block: 20px; flex-wrap: wrap; }
.logo { display: inline-flex; align-items: center; font: 800 22px/1 var(--f-display); letter-spacing: -0.02em; text-decoration: none; border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; }
.logo .caret { width: 3px; height: 20px; margin-inline: 3px; box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 60%, transparent); }
.links { display: flex; gap: 22px; margin-left: 8px; flex-wrap: wrap; }
.links a { color: var(--muted); text-decoration: none; font-size: 15px; }
.links a:hover { color: var(--fg); }
.sw { margin-left: auto; position: relative; display: flex; width: 64px; height: 32px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); font: 500 11px var(--f-mono); color: var(--muted); text-decoration: none; }
.sw span { flex: 1; display: grid; place-items: center; }
.sw i { position: absolute; top: 2px; left: 2px; width: 26px; height: 26px; border-radius: 50%; background: var(--fg); color: var(--bg); display: grid; place-items: center; font-style: normal; font-weight: 600; box-shadow: 0 2px 6px #0008; transition: transform .2s ease; }
.sw[data-lang="en"] i, .sw.flip i { transform: translateX(32px); }
.sw[data-lang="en"].flip i { transform: none; }
@media (max-width: 900px) {
  .sw, .links { margin-left: 0; }
}
</style>
